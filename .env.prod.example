# Production environment template for AWS EC2 deployment (compose.prod.yaml).
# On the EC2 host, copy this file to .env.prod (same directory as compose.prod.yaml)
# and fill in real values. Do NOT commit .env.prod — it is gitignored.

# AWS RDS MySQL endpoint. Use the dedicated app user, not the RDS master user.
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/gymflow
DB_USERNAME=gymflow_app
DB_PASSWORD=CHANGE_ME

# Redis runs as a container in this compose file; keep these as-is.
REDIS_HOST=redis
REDIS_PORT=6379

# Generate a new secret for production; do not reuse the local/dev JWT secret.
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRATION=CHANGE_ME

FRONTEND_ORIGIN=http://localhost:3000

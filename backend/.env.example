# Docker Compose local integration environment template.
# Copy this file to backend/.env.compose and fill in real values.
# Do NOT commit backend/.env.compose or backend/.env — both are gitignored.

DB_URL=jdbc:mysql://mysql:3306/gymflow
DB_USERNAME=gymflow
DB_PASSWORD=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRATION=CHANGE_ME

FRONTEND_ORIGIN=http://localhost:3000

# MySQL container initialization (docker compose only)
# MYSQL_USER/MYSQL_PASSWORD must match DB_USERNAME/DB_PASSWORD above.
# If DB_USERNAME is "root", omit MYSQL_USER/MYSQL_PASSWORD entirely —
# the official MySQL image forbids setting MYSQL_USER=root, so root must be
# configured only through MYSQL_ROOT_PASSWORD (set it equal to DB_PASSWORD).
MYSQL_DATABASE=gymflow
MYSQL_USER=gymflow
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
